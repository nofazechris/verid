# Copy to .env (never commit .env). Only variables an implementation actually reads belong here.

# --- Application -----------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Arc (verify against https://docs.arc.io before every deployment) --------
# There are intentionally NO silent defaults for these: a missing value is an error.
ARC_RPC_URL=
ARC_CHAIN_ID=
ARC_EXPLORER_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
# ERC-20 interface, 6 decimals (native gas USDC is 18 — never mix).
ARC_USDC_ADDRESS=

# --- Deployed contracts (outputs of the deploy script) -----------------------
VERID_REGISTRY_ADDRESS=
VERID_VALIDATION_ADDRESS=
VERID_ESCROW_ADDRESS=
# How long one chain transaction may wait for confirmation before the API answers "pending" (ms). Keep it under your host request limit.
VERID_CONFIRMATION_TIMEOUT_MS=20000

# --- Deployment parameters (addresses only, not secrets) ---------------------
VERID_OWNER=
VERID_ANCHORER=
# Optional: address registered on VeridValidation so the backend can record outcomes on-chain
# (without a registered validator nothing can ever release an escrow).
VERID_VALIDATOR=
# Optional: set to the USDC ERC-20 address to also deploy VeridEscrow (no owner/admin).
VERID_USDC=

# --- SECRETS: never commit, never expose to the browser ----------------------
# Preferred: use an encrypted Foundry keystore (`cast wallet import`) and pass
# `--account <name>` to forge instead of putting a raw key here.
# The backend relayer key (used only server-side to anchor):
VERID_RELAYER_PRIVATE_KEY=
# The validator key (signs on-chain validation records). Use a DIFFERENT key from the relayer so the two roles
# can be revoked independently. Required, with VERID_VALIDATION_ADDRESS, for escrow release/refund to work.
VERID_VALIDATOR_PRIVATE_KEY=

# --- Database / auth (added when those layers land) --------------------------
DATABASE_URL=
NEXTAUTH_SECRET=      # openssl rand -base64 32
NEXTAUTH_URL=         # public base URL of the app
RESEND_API_KEY=
RESEND_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
