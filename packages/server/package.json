{
  "name": "@verid/server",
  "version": "0.1.0",
  "private": true,
  "description": "VERID backend: Postgres schema, services and the /api/v1 handler (framework-agnostic, Web Request/Response).",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.2.14",
    "@verid/arc": "workspace:*",
    "@verid/core": "workspace:*",
    "@verid/validators": "workspace:*",
    "drizzle-orm": "0.36.4",
    "pg": "8.13.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/pg": "8.11.10",
    "drizzle-kit": "0.28.1",
    "typescript": "5.5.3",
    "vitest": "2.1.4",
    "tsx": "4.19.2"
  }
}